{
  "rules": {
    "funfacts": {
      ".read": true,
      ".write": false
    },
    "quizzes": {
      ".read": true,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid) || !data.exists()",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    }
  }
}
